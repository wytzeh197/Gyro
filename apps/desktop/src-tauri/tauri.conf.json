{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gyro",
  "version": "0.1.0-preview",
  "identifier": "dev.gyro.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @gyro-dev/codemode build && pnpm exec vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @gyro-dev/codemode build && pnpm exec vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gyro",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost;style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; frame-src gyro-canvas: http://localhost:* http://127.0.0.1:* https:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/Gyro/sessions/attachments/**"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "Copyright Gyro contributors",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/gyro-codemode"],
    "resources": ["../../../packages/codemode/THIRD_PARTY_NOTICES.md"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOTdENjgxOTc4NTI5ODYKUldTR0tZV1hnZGFYY0pkRTJpSmk1MUtkQ0dSUldJSE5JNy9JVCs4dmJBZnNTa0JRU3A4RWR6TEgK",
      "endpoints": [
        "https://github.com/wytzeh197/Gyro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
