; Gyro's filesystem-only command sandbox. IP networking is intentionally open.
; Policy vocabulary follows Apple's Seatbelt interface. Platform allowances were
; checked against OpenAI Codex's Apache-2.0 sandboxing policies:
; https://github.com/openai/codex/tree/main/codex-rs/sandboxing
(version 1)
(deny default)
(deny file-link)
(allow process-exec process-fork)
(allow signal process-info* (target same-sandbox))

; Runtime feature detection; these grant no process or filesystem mutations.
(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name "kern.argmax")
  (sysctl-name "kern.maxfilesperproc")
  (sysctl-name "kern.osproductversion")
  (sysctl-name "kern.osrelease")
  (sysctl-name "kern.ostype")
  (sysctl-name "kern.osversion")
  (sysctl-name "kern.usrstack64")
  (sysctl-name "kern.version")
  (sysctl-name "sysctl.proc_cputype"))

(allow file-write-data
  (require-all (literal "/dev/null") (vnode-type CHARACTER-DEVICE)))
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write*
  (require-all (regex #"^/dev/ttys[0-9]+$") (extension "com.apple.sandbox.pty")))
; A portable-pty slave opened before sandbox-exec lacks the extension.
(allow file-ioctl (regex #"^/dev/ttys[0-9]+$"))

; Network access is not filtered by destination. Unix connections are denied
; except for the system DNS resolver; SSH agent, Docker and Gyro sockets are
; not granted. Creating a socket does not authorize connecting or binding it.
(allow system-socket (socket-domain AF_INET) (socket-domain AF_INET6))
(allow system-socket (socket-domain AF_UNIX))
(allow network-outbound
  (remote unix-socket (literal "/private/var/run/mDNSResponder"))
  (remote unix-socket (literal "/var/run/mDNSResponder")))
(allow network-outbound (remote ip "*:*"))
(allow network-inbound network-bind (local ip "*:*"))
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.networkd")
  (global-name "com.apple.TrustEvaluationAgent")
  (global-name "com.apple.trustd.agent"))
; No SecurityServer, Apple Events, generic Mach lookup or other Unix connection.
